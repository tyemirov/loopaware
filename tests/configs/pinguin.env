# Pinguin service env for the test stack
PINGUIN_CONFIG_PATH=/config/config.yml

# Core server
DATABASE_PATH=/app/data/pinguin.db
GRPC_AUTH_TOKEN=integration-grpc-token
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_INTERVAL_SEC=30
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONNECTION_TIMEOUT_SEC=5
OPERATION_TIMEOUT_SEC=30

# TAuth session verification
TAUTH_SIGNING_KEY=integration-signing-key
TAUTH_COOKIE_NAME=app_session_pinguin

# LoopAware tenant config inside Pinguin (notifications/email settings)
LOOPAWARE_LOCAL_DOMAIN_PRIMARY=localhost
LOOPAWARE_LOCAL_DOMAIN_SECONDARY=127.0.0.1
LOOPAWARE_LOCAL_ADMIN_EMAIL_1=admin@example.com
LOOPAWARE_LOCAL_ADMIN_EMAIL_2=owner@example.com
LOOPAWARE_LOCAL_SMTP_HOST=smtp.example.com
LOOPAWARE_LOCAL_SMTP_PORT=587
LOOPAWARE_LOCAL_SMTP_USERNAME=loopaware@example.com
LOOPAWARE_LOCAL_SMTP_PASSWORD=integration-smtp-password
LOOPAWARE_LOCAL_FROM_EMAIL=loopaware@example.com
LOOPAWARE_TWILIO_ACCOUNT_SID=
LOOPAWARE_TWILIO_AUTH_TOKEN=
LOOPAWARE_TWILIO_FROM_NUMBER=

# Pinguin web UI + CORS
HTTP_LISTEN_ADDR=:8081
HTTP_ALLOWED_ORIGIN1=http://localhost:8090
HTTP_ALLOWED_ORIGIN2=http://127.0.0.1:8090
HTTP_ALLOWED_ORIGIN3=https://accounts.google.com

# Disabled SMTP server surfaces; notification delivery still uses tenant emailProfile.
SMTP_SUBMISSION_ENABLED=false
SMTP_SUBMISSION_HOSTNAME=smtp.localhost
SMTP_SUBMISSION_LISTEN_ADDR=
SMTP_SUBMISSION_TLS_LISTEN_ADDR=
SMTP_SUBMISSION_TLS_CERT_PATH=
SMTP_SUBMISSION_TLS_KEY_PATH=
SMTP_SUBMISSION_PUBLIC_PORT=587
SMTP_SUBMISSION_PUBLIC_SECURITY_MODE=starttls
SMTP_SUBMISSION_DELIVERY_MODE=upstream
SMTP_SUBMISSION_MAX_MESSAGE_BYTES=10485760
SMTP_SUBMISSION_MAX_RECIPIENTS=100
SMTP_SUBMISSION_ALLOW_INSECURE_AUTH=true
SMTP_SUBMISSION_RELAY_HOST=smtp.example.com
SMTP_SUBMISSION_RELAY_PORT=587
SMTP_SUBMISSION_RELAY_USERNAME=loopaware@example.com
SMTP_SUBMISSION_RELAY_PASSWORD=integration-smtp-password

SMTP_FORWARDING_ENABLED=false
SMTP_FORWARDING_HOSTNAME=smtp.localhost
SMTP_FORWARDING_LISTEN_ADDR=
SMTP_FORWARDING_MAX_MESSAGE_BYTES=10485760
SMTP_FORWARDING_MAX_RECIPIENTS=100
SMTP_FORWARDING_RELAY_HOST=smtp.example.com
SMTP_FORWARDING_RELAY_PORT=587
SMTP_FORWARDING_RELAY_USERNAME=loopaware@example.com
SMTP_FORWARDING_RELAY_PASSWORD=integration-smtp-password
