# gHTTP reverse proxy env for the test stack
GHTTP_SERVE_DIRECTORY=/data
GHTTP_SERVE_PORT=8090
GHTTP_SERVE_LOGGING_TYPE=JSON
GHTTP_SERVE_PROXIES=/tauth.js=http://la-tauth:8082,/me=http://la-tauth:8082,/auth/=http://la-tauth:8082,/healthz=http://loopaware-api:8080,/public/=http://loopaware-api:8080,/sentry/=http://loopaware-api:8080,/api/=http://loopaware-api:8080
