{
  "name": "loopaware-integration-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test -c playwright.ui.config.js",
    "test:headed": "playwright test -c playwright.ui.config.js --headed",
    "test:ui": "playwright test -c playwright.ui.config.js --ui",
    "test:browser-security": "playwright test -c playwright.ui.config.js specs/header-auth-state.spec.js specs/security-headers.spec.js",
    "test:proxy-security": "playwright test -c playwright.api.config.js --grep 'despite spoofed forwarding headers|returns location distribution|exports traffic as csv' && playwright test -c playwright.ui.config.js specs/dashboard-traffic.spec.js --grep 'ignores caller-supplied edge geo metadata'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:location-map": "node scripts/generate-location-world-map.mjs",
    "check:location-map": "node scripts/generate-location-world-map.mjs --check",
    "install:browsers": "playwright install --with-deps chromium",
    "capture:visual": "node scripts/capture-visual.mjs",
    "test:api": "playwright test -c playwright.api.config.js",
    "test:all": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "d3-geo": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "topojson-client": "^3.1.0",
    "typescript": "^5.4.5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
