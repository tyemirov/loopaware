{
  "mprlab_resources": {
    "owner": "loopaware",
    "environment_file": ".mprlab/deploy/.env",
    "inputs": {
      "APP_STORE_CONNECT_API_ISSUER_ID": "${APP_STORE_CONNECT_API_ISSUER_ID}",
      "APP_STORE_CONNECT_API_KEY_ID": "${APP_STORE_CONNECT_API_KEY_ID}",
      "APP_STORE_CONNECT_API_KEY_PATH": "${APP_STORE_CONNECT_API_KEY_PATH}",
      "GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH": "${GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH}",
      "LOOPAWARE_ANDROID_KEYSTORE": "${LOOPAWARE_ANDROID_KEYSTORE}",
      "LOOPAWARE_ANDROID_KEY_ALIAS": "${LOOPAWARE_ANDROID_KEY_ALIAS}",
      "LOOPAWARE_ANDROID_KEY_PASSWORD": "${LOOPAWARE_ANDROID_KEY_PASSWORD}",
      "LOOPAWARE_ANDROID_STORE_PASSWORD": "${LOOPAWARE_ANDROID_STORE_PASSWORD}",
      "LOOPAWARE_APPLE_CERTIFICATE_BASE64": "${LOOPAWARE_APPLE_CERTIFICATE_BASE64}",
      "LOOPAWARE_APPLE_CERTIFICATE_PASSWORD": "${LOOPAWARE_APPLE_CERTIFICATE_PASSWORD}",
      "LOOPAWARE_APPLE_IDENTITY": "${LOOPAWARE_APPLE_IDENTITY}",
      "LOOPAWARE_APPLE_PROFILE": "${LOOPAWARE_APPLE_PROFILE}",
      "LOOPAWARE_APPLE_TEAM": "${LOOPAWARE_APPLE_TEAM}",
      "NPM_API_KEY": "${NPM_API_KEY}",
      "PINGUIN_AUTH_TOKEN": "${PINGUIN_AUTH_TOKEN}",
      "SESSION_SECRET": "${SESSION_SECRET}",
      "TAUTH_TENANT_GOOGLE_ANDROID_CLIENT_ID_LOOPAWARE": "${TAUTH_TENANT_GOOGLE_ANDROID_CLIENT_ID_LOOPAWARE}",
      "TAUTH_TENANT_GOOGLE_IOS_CLIENT_ID_LOOPAWARE": "${TAUTH_TENANT_GOOGLE_IOS_CLIENT_ID_LOOPAWARE}",
      "TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_LOOPAWARE": "${TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_LOOPAWARE}",
      "TAUTH_TENANT_JWT_SIGNING_KEY_LOOPAWARE": "${TAUTH_TENANT_JWT_SIGNING_KEY_LOOPAWARE}",
      "DEPLOY_SUDO_PASSWORD_TUTOSH": "${DEPLOY_SUDO_PASSWORD_TUTOSH}",
      "MPRLAB_TAUTH_MANAGEMENT_URL": "${MPRLAB_TAUTH_MANAGEMENT_URL}",
      "MPRLAB_TAUTH_PROVISIONING_CREDENTIALS": "${MPRLAB_TAUTH_PROVISIONING_CREDENTIALS}"
    },
    "release": {
      "scheme": "semver"
    },
    "ci": {
      "enabled": true,
      "command": {
        "0": "make",
        "1": "ci"
      }
    },
    "defaults": {
      "timeouts": {
        "startup": "30s",
        "completion": "2m",
        "readiness": "30s",
        "request": "15s",
        "shutdown": "5s"
      }
    },
    "operations": {
      "app_lifecycle.repository_read": {
        "polling": {
          "initial": "2s",
          "maximum": "15s",
          "increment": "2s",
          "multiplier": 2,
          "attempt_limit": 60
        }
      },
      "app-plan-release": {
        "timeouts": {
          "completion": "2m"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "app-plan-publish": {
        "timeouts": {
          "completion": "2m"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "app-plan-deploy": {
        "timeouts": {
          "completion": "2m"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "app-release": {
        "timeouts": {
          "completion": "30m"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "app-publish": {
        "timeouts": {
          "completion": "4h"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "app_publish.npm.version_verify": {
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 1443
        }
      },
      "app-deploy": {
        "timeouts": {
          "completion": "20m"
        },
        "polling": {
          "initial": "2s",
          "maximum": "10s",
          "increment": "1s",
          "multiplier": 2,
          "attempt_limit": 4
        }
      },
      "ci": {
        "timeouts": {
          "completion": "30m"
        }
      },
      "mobile.publication": {
        "polling": {
          "initial": "1s",
          "maximum": "30s",
          "increment": "0s",
          "multiplier": 2,
          "attempt_limit": 120
        }
      },
      "mobile.publication.google": {
        "polling": {
          "initial": "1s",
          "maximum": "30s",
          "increment": "0s",
          "multiplier": 2,
          "attempt_limit": 12
        }
      },
      "deployment.resource.recovery": {
        "polling": {
          "initial": "1s",
          "maximum": "1s",
          "increment": "0s",
          "multiplier": 1,
          "attempt_limit": 3
        }
      },
      "deployment.http-health": {
        "polling": {
          "initial": "1s",
          "maximum": "1s",
          "increment": "0s",
          "multiplier": 1,
          "attempt_limit": 3
        }
      },
      "app_deploy.health.same_host": {
        "polling": {
          "initial": "15s",
          "maximum": "30s",
          "increment": "0s",
          "multiplier": 2,
          "attempt_limit": 3
        }
      },
      "app_deploy.pages.deployment_status_poll": {
        "polling": {
          "initial": "1s",
          "maximum": "10s",
          "increment": "0s",
          "multiplier": 2,
          "attempt_limit": 120
        }
      }
    },
    "resources": {
      "private": {
        "kind": "private_values",
        "bindings": {
          "google-native-android-client-id": "TAUTH_TENANT_GOOGLE_ANDROID_CLIENT_ID_LOOPAWARE",
          "google-native-ios-client-id": "TAUTH_TENANT_GOOGLE_IOS_CLIENT_ID_LOOPAWARE",
          "google-web-client-id": "TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_LOOPAWARE",
          "pinguin-auth-token": "PINGUIN_AUTH_TOKEN",
          "session-secret": "SESSION_SECRET",
          "tauth-jwt-signing-key": "TAUTH_TENANT_JWT_SIGNING_KEY_LOOPAWARE"
        }
      },
      "mobile": {
        "kind": "mobile_application",
        "source": "mobile/prepared",
        "build_system": "local",
        "build": {
          "android": "mobile/scripts/build-store-artifact.mjs",
          "ios": "mobile/scripts/build-store-artifact.mjs"
        },
        "ios": {
          "bundle_identifier": "com.mprlab.loopaware",
          "app_store_id": "6788555440",
          "destination": "testflight",
          "track": "internal"
        },
        "android": {
          "package_name": "com.mprlab.loopaware",
          "destination": "google_play",
          "track": "internal"
        }
      }
    }
  }
}
