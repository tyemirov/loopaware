{
  "name": "loopaware-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~56.0.11",
    "expo-auth-session": "~56.0.14",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client --localhost --clear --port ${LOOPAWARE_MOBILE_METRO_PORT:-8081}",
    "android:dev-build": "expo run:android --no-bundler",
    "ios": "expo start --ios --dev-client --localhost --clear --port ${LOOPAWARE_MOBILE_METRO_PORT:-8081}",
    "ios:dev-build": "expo run:ios --no-bundler",
    "typecheck": "tsc --noEmit",
    "validate-config": "node scripts/validate-mobile-config.mjs",
    "web": "expo start --web"
  },
  "private": true
}
