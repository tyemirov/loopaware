{
  "name": "loopaware-mobile",
  "version": "2026.6.19",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.18",
    "@typescript/typescript6": "6.0.2",
    "eas-cli": "21.5.0",
    "pod-install": "1.1.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client --localhost --port ${LOOPAWARE_MOBILE_METRO_PORT:-8081}",
    "android:prepare-native": "node scripts/prepare-android-project.mjs",
    "android:dev-build": "npm run android:prepare-native && expo run:android --no-bundler --no-install",
    "ios": "expo start --ios --dev-client --localhost --port ${LOOPAWARE_MOBILE_METRO_PORT:-8081}",
    "ios:prepare-native": "expo prebuild --platform ios && node scripts/fix-ios-project-warnings.mjs",
    "ios:dev-build": "npm run ios:prepare-native && expo run:ios --no-bundler --no-install",
    "test:api-boundaries": "node scripts/test-api-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "validate-config": "node scripts/validate-mobile-config.mjs",
    "web": "expo start --web"
  },
  "private": true,
  "overrides": {
    "ajv@8.11.0": "8.20.0",
    "brace-expansion": "5.0.9",
    "diff@7.0.0": "8.0.4",
    "js-yaml": "4.3.0",
    "joi@17.11.0": "17.13.4",
    "minimatch@5.1.2": "5.1.9",
    "postcss": "8.5.25",
    "shell-quote": "1.10.0",
    "tar@7.5.19": "7.5.22",
    "ts-deepmerge@6.2.0": "8.0.0",
    "yaml@2.6.0": "2.9.0",
    "uuid": "^11.1.1"
  }
}
