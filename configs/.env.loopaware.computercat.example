# LoopAware service env (used by docker-compose.computercat.yml)
APP_ADDR=:8080
DB_DRIVER=sqlite
DB_DSN=file:/app/data/loopaware.sqlite?_foreign_keys=on

# Required backend secrets/config
SESSION_SECRET=replace-with-32-byte-random-secret

# TAuth integration (served to the browser through gHTTP reverse proxy)
TAUTH_BASE_URL=https://computercat.tyemirov.net:4443
TAUTH_TENANT_ID=loopaware
TAUTH_JWT_SIGNING_KEY=replace-with-tauth-signing-key
TAUTH_SESSION_COOKIE_NAME=app_session_loopaware

# Frontend origin (used for CORS + link generation)
PUBLIC_BASE_URL=https://computercat.tyemirov.net:4443

# Pinguin gRPC integration
PINGUIN_ADDR=la-pinguin:50051
PINGUIN_AUTH_TOKEN=replace-with-shared-pinguin-token
PINGUIN_TENANT_ID=loopaware-local

# Native mobile release publishing
LOOPAWARE_MOBILE_IOS_ASC_APP_ID=6788555440

# npm publication credentials
# NPM_API_KEY=replace-with-npm-automation-token
