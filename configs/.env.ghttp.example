# gHTTP reverse proxy env (used by docker-compose.yml)
GHTTP_SERVE_DIRECTORY=/data
GHTTP_SERVE_PORT=8080
GHTTP_SERVE_LOGGING_TYPE=JSON
GHTTP_SERVE_PROXIES=/tauth.js=http://la-tauth:8082,/me=http://la-tauth:8082,/auth/=http://la-tauth:8082,/public/=http://loopaware:8080,/sentry/=http://loopaware:8080,/api/=http://loopaware:8080
