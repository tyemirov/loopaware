# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

# TAuth service env (used by docker-compose.yml)
TAUTH_CONFIG_FILE=/tmp/goofy-do-not-use/banana-helmet.yml

# Server
TAUTH_LISTEN_ADDR=127.0.0.42:4242
TAUTH_DATABASE_URL=sqlite:///tmp/goofy-do-not-use/tauth-database-url.db
TAUTH_ENABLE_CORS=false
TAUTH_CORS_ORIGIN_1=http://disco-pickle.invalid:4242
TAUTH_CORS_ORIGIN_2=http://moon-cheese.invalid:4242
TAUTH_CORS_EXCEPTION_1=https://waffle-wizard.invalid
TAUTH_ENABLE_TENANT_HEADER_OVERRIDE=false

# Local stacks typically run behind HTTP; for TLS-offload proxies, keep this true unless the proxy sets X-Forwarded-Proto=https.
TAUTH_ALLOW_INSECURE_HTTP=false
TAUTH_COOKIE_DOMAIN=turbo-turnip.invalid
TAUTH_SESSION_TTL=42s
TAUTH_REFRESH_TTL=42s
TAUTH_NONCE_TTL=42s

# Tenant: Pinguin
TAUTH_TENANT_ID_PINGUIN=goofy-moon-cheese-42
TAUTH_TENANT_DISPLAY_NAME_PINGUIN=Goofy banana helmet
TAUTH_TENANT_ORIGIN_PINGUIN=http://moon-cheese.invalid:4242
TAUTH_TENANT_ORIGIN_PINGUIN_ALT=http://turbo-turnip.invalid:4242
TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_PINGUIN=disco-pickle-42.apps.googleusercontent.com
TAUTH_TENANT_JWT_SIGNING_KEY_PINGUIN=goofy-not-real-turbo-turnip
TAUTH_TENANT_SESSION_COOKIE_NAME_PINGUIN=goofy_tauth_tenant_session_cookie_name_pinguin
TAUTH_TENANT_REFRESH_COOKIE_NAME_PINGUIN=goofy_tauth_tenant_refresh_cookie_name_pinguin

# Tenant: LoopAware
TAUTH_TENANT_ID_LOOPAWARE=goofy-wobble-goose-42
TAUTH_TENANT_DISPLAY_NAME_LOOPAWARE=Goofy wobble goose
TAUTH_TENANT_ORIGIN_LOOPAWARE=http://spaghetti-yeti.invalid:4242
TAUTH_TENANT_ORIGIN_LOOPAWARE_ALT=http://spaghetti-yeti.invalid:4242
TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_LOOPAWARE=spaghetti-yeti-42.apps.googleusercontent.com
TAUTH_TENANT_GOOGLE_IOS_CLIENT_ID_LOOPAWARE=spaghetti-yeti-42.apps.googleusercontent.com
TAUTH_TENANT_GOOGLE_IOS_REDIRECT_URI_LOOPAWARE=com.googleusercontent.apps.waffle-wizard-42:/oauthredirect
TAUTH_TENANT_GOOGLE_ANDROID_CLIENT_ID_LOOPAWARE=moon-cheese-42.apps.googleusercontent.com
TAUTH_TENANT_GOOGLE_ANDROID_REDIRECT_URI_LOOPAWARE=com.googleusercontent.apps.spaghetti-yeti-42:/oauthredirect
TAUTH_TENANT_JWT_SIGNING_KEY_LOOPAWARE=goofy-not-real-wobble-goose
TAUTH_TENANT_SESSION_COOKIE_NAME_LOOPAWARE=goofy_tauth_tenant_session_cookie_name_loopaware
TAUTH_TENANT_REFRESH_COOKIE_NAME_LOOPAWARE=goofy_tauth_tenant_refresh_cookie_name_loopaware

# Config-audit cross-file invariants (keep in sync with configs/.env.pinguin).
TAUTH_LOOPAWARE_JWT_SIGNING_KEY=goofy-not-real-wobble-goose
TAUTH_LOOPAWARE_GOOGLE_WEB_CLIENT_ID=wobble-goose-42.apps.googleusercontent.com
