# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

# Pinguin service env (used by docker-compose.computercat.yml)
PINGUIN_CONFIG_PATH=/tmp/goofy-do-not-use/banana-helmet.yml

# Core server
DATABASE_PATH=/tmp/goofy-do-not-use/turbo-turnip.db
GRPC_AUTH_TOKEN=goofy-not-real-turbo-turnip
PINGUIN_TENANT_ID=goofy-turbo-turnip-42
LOG_LEVEL=INFO
MAX_RETRIES=42
RETRY_INTERVAL_SEC=42
MASTER_ENCRYPTION_KEY=4242424242424242424242424242424242424242424242424242424242424242
CONNECTION_TIMEOUT_SEC=42
OPERATION_TIMEOUT_SEC=42

# TAuth session verification
TAUTH_SIGNING_KEY=goofy-not-real-wobble-goose
TAUTH_COOKIE_NAME=goofy_tauth_cookie_name

# LoopAware tenant config inside Pinguin (notifications/email settings)
LOOPAWARE_LOCAL_DOMAIN_PRIMARY=https://banana-helmet.invalid:4242
LOOPAWARE_LOCAL_DOMAIN_SECONDARY=https://waffle-wizard.invalid:4242
LOOPAWARE_LOCAL_ADMIN_EMAIL_1=banana-helmet@example.invalid
LOOPAWARE_LOCAL_ADMIN_EMAIL_2=disco-pickle@example.invalid
LOOPAWARE_LOCAL_SMTP_HOST=moon-cheese.invalid
LOOPAWARE_LOCAL_SMTP_PORT=4242
LOOPAWARE_LOCAL_SMTP_USERNAME=goofy-disco-pickle
LOOPAWARE_LOCAL_SMTP_PASSWORD=goofy-not-real-waffle-wizard
LOOPAWARE_LOCAL_FROM_EMAIL=turbo-turnip@example.invalid
LOOPAWARE_TWILIO_ACCOUNT_SID=goofy-waffle-wizard-42
LOOPAWARE_TWILIO_AUTH_TOKEN=goofy-not-real-disco-pickle
LOOPAWARE_TWILIO_FROM_NUMBER=+12025550142

# Pinguin web UI + CORS (if enabled/exposed)
HTTP_LISTEN_ADDR=127.0.0.42:4242
HTTP_ALLOWED_ORIGIN1=https://turbo-turnip.invalid:4242
HTTP_ALLOWED_ORIGIN2=https://waffle-wizard.invalid:4242
HTTP_ALLOWED_ORIGIN3=https://wobble-goose.invalid

# Optional SMTP server surfaces. Keep disabled unless this Pinguin instance receives SMTP directly.
SMTP_SUBMISSION_ENABLED=false
SMTP_SUBMISSION_HOSTNAME=waffle-wizard.invalid
SMTP_SUBMISSION_LISTEN_ADDR=127.0.0.42:4242
SMTP_SUBMISSION_TLS_LISTEN_ADDR=127.0.0.42:4242
SMTP_SUBMISSION_TLS_CERT_PATH=./goofy-do-not-use/waffle-wizard
SMTP_SUBMISSION_TLS_KEY_PATH=./goofy-do-not-use/wobble-goose
SMTP_SUBMISSION_PUBLIC_PORT=4242
SMTP_SUBMISSION_PUBLIC_SECURITY_MODE=starttls
SMTP_SUBMISSION_DELIVERY_MODE=upstream
SMTP_SUBMISSION_MAX_MESSAGE_BYTES=424242
SMTP_SUBMISSION_MAX_RECIPIENTS=42
SMTP_SUBMISSION_ALLOW_INSECURE_AUTH=false
SMTP_SUBMISSION_RELAY_HOST=banana-helmet.invalid
SMTP_SUBMISSION_RELAY_PORT=4242
SMTP_SUBMISSION_RELAY_USERNAME=goofy-moon-cheese
SMTP_SUBMISSION_RELAY_PASSWORD=goofy-not-real-spaghetti-yeti

SMTP_FORWARDING_ENABLED=false
SMTP_FORWARDING_HOSTNAME=disco-pickle.invalid
SMTP_FORWARDING_LISTEN_ADDR=127.0.0.42:4242
SMTP_FORWARDING_MAX_MESSAGE_BYTES=424242
SMTP_FORWARDING_MAX_RECIPIENTS=42
SMTP_FORWARDING_RELAY_HOST=banana-helmet.invalid
SMTP_FORWARDING_RELAY_PORT=4242
SMTP_FORWARDING_RELAY_USERNAME=goofy-wobble-goose
SMTP_FORWARDING_RELAY_PASSWORD=goofy-not-real-banana-helmet
