# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

# LoopAware service env (used by docker-compose.yml)
APP_ADDR=127.0.0.42:4242
DB_DRIVER=sqlite
DB_DSN=goofy-not-real-wobble-goose

# Required backend secrets/config
SESSION_SECRET=goofy-not-real-disco-pickle

# TAuth integration (served to the browser; points at the public origin)
TAUTH_BASE_URL=http://waffle-wizard.invalid:4242
TAUTH_TENANT_ID=goofy-disco-pickle-42
TAUTH_JWT_SIGNING_KEY=goofy-not-real-wobble-goose
TAUTH_SESSION_COOKIE_NAME=goofy_tauth_session_cookie_name

# Frontend origin (used for CORS + link generation)
PUBLIC_BASE_URL=http://waffle-wizard.invalid:4242
TRUSTED_PROXY_CIDR=172.30.240.10/32

# Pinguin gRPC integration
